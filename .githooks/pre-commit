#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if ! git diff --quiet; then
  echo "Stage or stash unstaged changes before committing so checks cover the commit." >&2
  exit 1
fi
if [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "Stage or ignore untracked files before committing so checks cover the commit." >&2
  exit 1
fi
exec make check
